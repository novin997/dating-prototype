# Copy to .env.local and fill in, then restart the dev server

# Shared password for the results page
RESULTS_PASSWORD=

# Set to "on" to show the date planner
DATE_PLANNER=on

# Get a key at https://opencode.ai/zen
OPENCODE_API_KEY=

# Optional: defaults to space-bunny-free
OPENCODE_MODEL=deepseek-v4.1-flash

# Optional: Postgres connection string. Without it, answers are saved to .data/responses.json
# DATABASE_URL=postgres://user:password@host:5432/dbname
